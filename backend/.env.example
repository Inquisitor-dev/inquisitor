PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
GEMINI_API_KEY=your_gemini_api_key
# Sırayla denenecek modeller (ilki yoğunsa sonrakine geçilir); yerelde ve canlıda aynı zincir kullanılır
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest
JWT_SECRET=replace_with_a_long_random_secret
MAIL_USER=your_gmail_address
MAIL_PASS=your_gmail_app_password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
# Yapay zekasiz test modu: sadece yerel gelistirmede true yapin
# ALLOW_TEST_MODE=true

# Stripe Test Modu (veya sandbox)
# Boş bırakılırsa yerel simülasyon modu devreye girer
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
FRONTEND_URL=http://localhost:3000
