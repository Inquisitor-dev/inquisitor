// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  passwordHash      String?
  isAdmin           Boolean       @default(false)
  isPremium         Boolean       @default(false)
  verificationCode  String?
  codeExpiresAt     DateTime?
  isVerified        Boolean       @default(false)
  dailySessionCount Int           @default(0)
  dailyMessageCount Int           @default(0)
  lastResetDate     String        @default("")
  musicVolume       Float         @default(0.4) // Ana menü müziği, 0..1
  musicMuted        Boolean       @default(false)
  createdAt         DateTime      @default(now())
  sessions          GameSession[]
}

model GameSession {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  status      String            @default("ACTIVE") // ACTIVE, WON, LOST
  isTestMode  Boolean           @default(false) // Yapay zekasız test oturumu: hikaye üretilmez, NPC'ler hazır cevap verir
  difficulty  String            @default("easy")   // easy, medium, hard
  scenarioType String           @default("medieval") // medieval, modern, cyberpunk
  scenario    String?           // Dinamik hikaye özeti
  truthReveal String?           @db.Text // Gerçek hikaye perde arkası
  locationClues Json?                    // Her mekan için gizli ipuçları listesi
  culpritId   String?           // Cadı/Suçlu olan NPC ID'si
  caseFacts   Json?             // Kodla belirlenen vaka gerçekleri (case-setup.ts CaseFacts); aktif oturumda gizli
  currentDay  Int               @default(1)
  timeOfDay   Int               @default(0) // 0: Sabah, 1: Öğlen, 2: İkindi, 3: Akşam, 4: Gece
  notes         String?           @default("") // Engizisyoncunun notları
  activeWarrants String[]         @default([]) // Aktif arama izinleri
  usedWarrants   String[]         @default([]) // Kullanılmış arama izinleri
  warrantsIssued Int               @default(0)  // Toplam alınan izin sayısı
  createdAt     DateTime          @default(now())
  npcStates     SessionNpcState[]
  dialogues     DialogueHistory[]
  evidence      Evidence[]
}

model Npc {
  id          String            @id @default(uuid())
  name        String            @unique
  description String
  basePrompt  String
  baseFear    Int               @default(0)
  baseLie     Int               @default(0)
  states      SessionNpcState[]
}

model SessionNpcState {
  id            String      @id @default(uuid())
  sessionId     String
  session       GameSession @relation(fields: [sessionId], references: [id])
  npcId         String
  npc           Npc         @relation(fields: [npcId], references: [id])
  currentFear   Int         @default(0)
  lieTendency   Int         @default(0)
  dynamicPrompt String?     // Bu oturum için karaktere özel yazılmış gizli bilgi/motivasyon
  shownEvidenceIds String[] @default([]) // Bu karaktere gösterilmiş kanıtlar (aynı kanıt korkuyu iki kez artırmaz)
  
  @@unique([sessionId, npcId])
}

model DialogueHistory {
  id        String      @id @default(uuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id])
  npcId     String
  speaker   String
  message   String
  dayNumber Int         @default(1)
  createdAt DateTime    @default(now())
}

// Kanıt Defteri: oyuncunun bir vakada bulduğu ipuçları, doğrulayan kanıtlar ve aldığı itiraflar
model Evidence {
  id        String      @id @default(uuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id])
  kind      String      // CLUE, VERIFICATION, CONFESSION
  category  String      @default("ITEM") // ITEM: Envanter'deki fiziksel nesne, STATEMENT: Not defterine yazılan ifade
  sourceId  String      // İpucunda mekân id'si, itiraf ve tanıklıkta karakter id'si
  text      String      @db.Text
  dayNumber Int         @default(1)
  createdAt DateTime    @default(now())

  @@unique([sessionId, kind, sourceId])
}
