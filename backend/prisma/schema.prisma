// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  passwordHash      String?
  isAdmin           Boolean       @default(false)
  verificationCode  String?
  codeExpiresAt     DateTime?
  isVerified        Boolean       @default(false)
  dailySessionCount Int           @default(0)
  dailyMessageCount Int           @default(0)
  lastResetDate     String        @default("")
  createdAt         DateTime      @default(now())
  sessions          GameSession[]
}

model GameSession {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  status      String            @default("ACTIVE") // ACTIVE, WON, LOST
  scenario    String?           // Dinamik hikaye özeti
  culpritId   String?           // Cadı/Suçlu olan NPC ID'si
  currentDay  Int               @default(1)
  timeOfDay   Int               @default(0) // 0: Sabah, 1: Öğlen, 2: İkindi, 3: Akşam, 4: Gece
  notes         String?           @default("") // Engizisyoncunun notları
  issuedWarrant String?           // Peder'den alınan arama izni (örn: "tavern")
  isWarrantUsed Boolean           @default(false) // İzin kullanıldı mı?
  createdAt     DateTime          @default(now())
  npcStates     SessionNpcState[]
  dialogues     DialogueHistory[]
}

model Npc {
  id          String            @id @default(uuid())
  name        String            @unique
  description String
  basePrompt  String
  baseFear    Int               @default(0)
  baseLie     Int               @default(0)
  states      SessionNpcState[]
}

model SessionNpcState {
  id            String      @id @default(uuid())
  sessionId     String
  session       GameSession @relation(fields: [sessionId], references: [id])
  npcId         String
  npc           Npc         @relation(fields: [npcId], references: [id])
  currentFear   Int         @default(0)
  lieTendency   Int         @default(0)
  dynamicPrompt String?     // Bu oturum için karaktere özel yazılmış gizli bilgi/motivasyon
  
  @@unique([sessionId, npcId])
}

model DialogueHistory {
  id        String      @id @default(uuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id])
  npcId     String
  speaker   String
  message   String
  dayNumber Int         @default(1)
  createdAt DateTime    @default(now())
}
