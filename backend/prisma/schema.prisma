// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  sessions     GameSession[]
}

model GameSession {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  status    String          @default("ACTIVE") // ACTIVE, WON, LOST
  createdAt DateTime        @default(now())
  npcStates SessionNpcState[]
  dialogues DialogueHistory[]
}

model Npc {
  id          String            @id @default(uuid())
  name        String            @unique
  description String
  basePrompt  String
  baseFear    Int               @default(0)
  baseLie     Int               @default(0)
  states      SessionNpcState[]
}

model SessionNpcState {
  id          String      @id @default(uuid())
  sessionId   String
  session     GameSession @relation(fields: [sessionId], references: [id])
  npcId       String
  npc         Npc         @relation(fields: [npcId], references: [id])
  currentFear Int         @default(0)
  lieTendency Int         @default(0)
  
  @@unique([sessionId, npcId])
}

model DialogueHistory {
  id        String      @id @default(uuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id])
  npcId     String
  speaker   String
  message   String
  createdAt DateTime    @default(now())
}
