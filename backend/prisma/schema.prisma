// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  username          String?       @unique       // Kullanıcı tarafından seçilen takma ad
  avatar            String        @default("avatar_1") // Seçilen avatar (avatar_1 .. avatar_5)
  passwordHash      String?
  isAdmin           Boolean       @default(false)
  isPremium         Boolean       @default(false)
  verificationCode  String?
  codeExpiresAt     DateTime?
  isVerified        Boolean       @default(false)
  dailySessionCount Int           @default(0)
  dailyMessageCount Int           @default(0)
  lastResetDate     String        @default("")
  musicVolume       Float         @default(0.4) // Ana menü müziği, 0..1
  musicMuted        Boolean       @default(false)
  footstepVolume    Float         @default(0.45) // Yürüme/adım sesi, 0..1
  footstepMuted     Boolean       @default(false)
  doorVolume        Float         @default(0.55) // Kapı sesi, 0..1
  doorMuted         Boolean       @default(false)
  tokenBalance      Int           @default(1000) // Başlangıç bakiyesi (akçe/token)
  score             Int           @default(0)    // Sıralama için toplam dedektiflik puanı
  createdAt         DateTime      @default(now())
  sessions          GameSession[]
  purchases         UserPurchase[]
  tokenTransactions TokenTransaction[]
}

model GameSession {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  status      String            @default("ACTIVE") // ACTIVE, WON, LOST
  isTestMode  Boolean           @default(false) // Yapay zekasız test oturumu: hikaye üretilmez, NPC'ler hazır cevap verir
  difficulty  String            @default("easy")   // easy, medium, hard
  scenarioType String           @default("medieval") // medieval, modern, cyberpunk
  scenario    String?           // Dinamik hikaye özeti
  truthReveal String?           @db.Text // Gerçek hikaye perde arkası
  locationClues Json?                    // Her mekan için gizli ipuçları listesi
  culpritId   String?           // Cadı/Suçlu olan NPC ID'si
  caseFacts   Json?             // Kodla belirlenen vaka gerçekleri (case-setup.ts CaseFacts); aktif oturumda gizli
  currentDay  Int               @default(1)
  timeOfDay   Int               @default(0) // 0: Sabah, 1: Öğlen, 2: İkindi, 3: Akşam, 4: Gece
  notes         String?           @default("") // Engizisyoncunun notları
  activeWarrants String[]         @default([]) // Aktif arama izinleri
  usedWarrants   String[]         @default([]) // Kullanılmış arama izinleri
  warrantsIssued Int               @default(0)  // Toplam alınan izin sayısı
  notebookState  Json?                          // Not Defteri: gün sayfalarındaki yazılar ve kayıt kartlarının yerleri (src/notebook/notebook.ts)
  boardState     Json?                          // Soruşturma Panosu: kartlar, konumlar ve ipler (src/board/board.ts)
  boardThought   String?           @db.Text     // Panoda son "Düşün"ün iç ses metni
  boardThoughtDay Int              @default(0)  // Son "Düşün"ün günü; günde bir kez düşünülür
  characterId    String            @default("engizitor") // Vaka başında kilitlenen oyuncu karakteri; yetenekleri belirler
  abilityState   Json?                          // Yetenek kullanımları ve süren etkileri (src/abilities/abilities.ts AbilityState)
  verdictReport  Json?                          // Hüküm Dosyası: oyuncunun raporu ve puanı (src/game-sessions/verdict/verdict-report.ts)
  storyId        String?                        // Havuzdan seçilmişse bağlı olduğu hikâye paketi
  story          Story?            @relation(fields: [storyId], references: [id])
  createdAt     DateTime          @default(now())
  npcStates     SessionNpcState[]
  dialogues     DialogueHistory[]
  evidence      Evidence[]
}

enum StoryStatus {
  DRAFT
  APPROVED
  REJECTED
}

// Önceden üretilmiş ve doğrulanmış hikâye havuzu (Vaka Motoru v2)
model Story {
  id            String        @id @default(uuid())
  universe      String        // medieval, modern, cyberpunk, china, winter
  difficulty    String        // easy, medium, hard
  wildcardCount Int           @default(0)
  gameMode      String        @default("standard")
  content       Json          // StoryPackage: kodun vaka planı, gerçekler ve yapay zekâ metinleri
  status        StoryStatus   @default(DRAFT)
  reviewResults Json?         // Hakem ve onay sonuçları: bulgular, notlar, karar
  ruleVersion   Int           @default(1)   // Kural sürümü; kurallar geliştikçe eski hikâyeler yeniden taranabilir
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      GameSession[]

  @@index([universe, difficulty, status])
  @@index([status])
}

model Npc {
  id          String            @id @default(uuid())
  name        String            @unique
  description String
  basePrompt  String
  baseFear    Int               @default(0)
  baseLie     Int               @default(0)
  states      SessionNpcState[]
}

model SessionNpcState {
  id            String      @id @default(uuid())
  sessionId     String
  session       GameSession @relation(fields: [sessionId], references: [id])
  npcId         String
  npc           Npc         @relation(fields: [npcId], references: [id])
  currentFear   Int         @default(0)
  lieTendency   Int         @default(0)
  dynamicPrompt String?     // Bu oturum için karaktere özel yazılmış gizli bilgi/motivasyon
  shownEvidenceIds String[] @default([]) // Bu karaktere gösterilmiş kanıtlar (aynı kanıt korkuyu iki kez artırmaz)
  
  @@unique([sessionId, npcId])
}

model DialogueHistory {
  id        String      @id @default(uuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id])
  npcId     String
  speaker   String
  message   String
  dayNumber Int         @default(1)
  createdAt DateTime    @default(now())
}

// Kanıt Defteri: oyuncunun bir vakada bulduğu ipuçları, doğrulayan kanıtlar ve aldığı itiraflar
model Evidence {
  id        String      @id @default(uuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id])
  kind      String      // CLUE, VERIFICATION, CONFESSION
  category  String      @default("ITEM") // ITEM: Envanter'deki fiziksel nesne, STATEMENT: Not defterine yazılan ifade
  sourceId  String      // İpucunda mekân id'si, itiraf ve tanıklıkta karakter id'si
  text      String      @db.Text
  dayNumber Int         @default(1)
  createdAt DateTime    @default(now())

  @@unique([sessionId, kind, sourceId])
}

// Satın alınan market eşyaları (evrenler, zorluklar, hikâyeler, kozmetikler)
// Yapay zekâ çağrılarının token kullanımı: maliyet ölçümü için her başarılı çağrıda bir satır yazılır
model LlmUsage {
  id               String   @id @default(uuid())
  sessionId        String?  // Çağrının ait olduğu vaka (yabancı anahtar yok; vaka silinse de kayıt kalır)
  kind             String   // SCENARIO | SCENARIO_REVIEW | NPC_REPLY | CONFRONT | NARRATOR | BOARD_THOUGHT | CONTRADICTION_SCAN | VERDICT_JUDGE | CLUE_REPAIR | WITNESS_REPAIR | STORY_REVIEW
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  durationMs       Int
  createdAt        DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model UserPurchase {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  itemId    String   // örn: universe_modern, difficulty_hard, cosmetic_plague_mask
  category  String   // universe, difficulty, story, cosmetic, outfit
  pricePaid Int
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

// Token hareket defteri (ledger): her giriş ve çıkışın değişmez kaydı
model TokenTransaction {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  amount       Int      // Pozitif: kazanılan / yüklenen, Negatif: harcanan
  balanceAfter Int      // İşlem sonrası güncel bakiye
  reason       String   // INITIAL_GRANT, CASE_REWARD, ITEM_PURCHASE, STRIPE_PURCHASE
  metadata     Json?    // { itemId, sessionId, stripeSessionId, amountEur ... }
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
